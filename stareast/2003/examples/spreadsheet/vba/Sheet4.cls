Private Sub getFileNameForCell(aCell As String, aFileFilter As String)

    ' a generic function to call the file dialog and set the contents
    ' of the cell defined by aCell to be the value chosen in the dialogue
    ' aFileFilter is the filter to  be applied to the file dialog

    On Error Resume Next

    Dim sFileName As String

    sFileName = Application.GetSaveAsFilename(InitialFilename:=Worksheets("macros").Range(aCell), fileFilter:=aFileFilter)

    If sFileName <> False Then
        Worksheets("macros").Range(aCell) = sFileName
    End If

End Sub


Private Sub browseForOutput_Click()

    ' choose the path for B6 the output file

    getFileNameForCell "b6", "*.* (*.*),*.*"

End Sub

Private Sub btnBrowseForDot_Click()

    ' choose the path for B5 the dot location

    getFileNameForCell "b5", "*.exe (*.exe),*.exe"
End Sub

Private Sub btnFileBrowse_Click()

    ' choose the path for B3 the output dot file

    getFileNameForCell "b3", "dot file (*.dot),*.dot"

End Sub

Private Sub btnGenerateDot_Click()

    On Error Resume Next

    ' write the code generated by makeDotFormat to the file
    ' specified in cell B3

    'should really check for file existing etc.

    Open Worksheets("macros").Range("b3") For Output As #1
    Print #1, makeDotFormat()
    Close #1

End Sub

Private Sub btnShowDot_Click()
    On Error Resume Next

    ' display the code genereated by makeDotFormat in a message box

    MsgBox makeDotFormat()

End Sub




Private Sub doDot_Click()

    On Error Resume Next

    Dim doThis As String

    ' create the command line to generate the dot output
    ' put quotes around the path to handle spaces in the file names
    ' "{B5}" -T{B7} "{B3}" -o "{B6}"

    doThis = """" & Worksheets("macros").Range("b5") & """" & " -T" & Worksheets("macros").Range("b7") & " " & """" & Worksheets("macros").Range("b3") & """" & " -o " & """" & Worksheets("macros").Range("b6") & """"

    ' shell the command to run it
    Call Shell(doThis, vbNormalFocus)

    ' now start up the viewer application with the output as a paramater by running
    ' "{B4}" "{B6}"
    Call Shell("""" & Worksheets("macros").Range("b4") & """" & " " & """" & Worksheets("macros").Range("b6") & """", vbNormalFocus)  ' try and open it!

End Sub

Private Sub setViewerPath_Click()

    ' choose the path for B4 the viewer application

    getFileNameForCell "b4", "*.exe (*.exe),*.exe"

End Sub
